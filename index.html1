<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>BACKSTAGE THRIFT | Rock & Grunge Archive</title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Syne:wght@700;800;900&family=Tajawal:wght@400;600;700;900&display=swap" rel="stylesheet">
  
  <!-- Firebase SDKs -->
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>

  <style>
    :root {
      --bg: #09090b;
      --card-bg: #121214;
      --border: #27272a;
      --accent: #e11d48; /* Rockstar Crimson */
      --accent-hover: #be123c;
      --text-main: #f4f4f5;
      --text-muted: #a1a1aa;
      --grunge-gold: #eab308;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg);
      color: var(--text-main);
      font-family: 'Tajawal', sans-serif;
      overflow-x: hidden;
      background-image: 
        radial-gradient(circle at 10% 20%, rgba(225, 29, 72, 0.08) 0%, transparent 45%),
        radial-gradient(circle at 90% 80%, rgba(234, 179, 8, 0.05) 0%, transparent 45%);
      background-attachment: fixed;
      min-height: 100vh;
    }

    h1, h2, h3, .brand-font {
      font-family: 'Syne', sans-serif;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* HEADER */
    header {
      border-bottom: 1px solid var(--border);
      padding: 1rem 1.2rem;
      position: sticky;
      top: 0;
      background: rgba(9, 9, 11, 0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand {
      font-family: 'Cinzel', serif;
      font-size: 1.35rem;
      font-weight: 900;
      color: #fff;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .brand span {
      color: var(--accent);
      text-shadow: 0 0 15px rgba(225, 29, 72, 0.7);
    }

    .btn-cart {
      background: #18181b;
      border: 1px solid var(--border);
      color: #fff;
      padding: 0.5rem 1rem;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 700;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
    }

    .btn-cart:active {
      transform: scale(0.96);
    }

    .cart-badge {
      background: var(--accent);
      color: #fff;
      border-radius: 50%;
      width: 20px;
      height: 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
    }

    /* HERO */
    .hero {
      text-align: center;
      padding: 2.2rem 1rem 1.8rem;
      border-bottom: 1px solid var(--border);
    }

    .hero h1 {
      font-size: clamp(1.8rem, 6vw, 3.2rem);
      font-weight: 900;
      line-height: 1.15;
      margin-bottom: 0.6rem;
      background: linear-gradient(180deg, #fff 0%, #71717a 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      color: var(--text-muted);
      font-size: 0.95rem;
      max-width: 550px;
      margin: 0 auto 1.4rem;
      line-height: 1.5;
    }

    .gender-buttons {
      display: inline-flex;
      background: #18181b;
      padding: 4px;
      border-radius: 12px;
      border: 1px solid var(--border);
      gap: 4px;
      width: 100%;
      max-width: 340px;
    }

    .btn-gender {
      flex: 1;
      background: transparent;
      border: none;
      color: var(--text-muted);
      padding: 0.65rem 0;
      font-size: 0.9rem;
      font-weight: 700;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-gender.active {
      background: var(--accent);
      color: #fff;
      box-shadow: 0 0 16px rgba(225, 29, 72, 0.4);
    }

    /* CATEGORIES BAR (Smooth mobile scroll) */
    .categories-bar {
      display: flex;
      overflow-x: auto;
      padding: 1rem 1rem;
      gap: 0.6rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .categories-bar::-webkit-scrollbar { display: none; }

    .cat-pill {
      white-space: nowrap;
      padding: 0.5rem 1rem;
      background: #18181b;
      border: 1px solid var(--border);
      color: var(--text-muted);
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      flex-shrink: 0;
    }

    .cat-pill.active {
      background: #fff;
      color: #000;
      border-color: #fff;
    }

    /* CONTAINER */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.2rem 1rem 5rem;
    }

    /* CUSTOM BANNER */
    .custom-tee-banner {
      background: linear-gradient(135deg, #18181b 0%, #27272a 100%);
      border: 1px dashed var(--accent);
      border-radius: 16px;
      padding: 1.5rem;
      margin-bottom: 2.2rem;
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.2rem;
      align-items: center;
    }

    @media (min-width: 768px) {
      .custom-tee-banner {
        grid-template-columns: 1.2fr 0.8fr;
        padding: 2rem;
      }
    }

    /* PRODUCTS GRID */
    .grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.8rem;
    }

    @media (min-width: 768px) {
      .grid {
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.5rem;
      }
    }

    .product-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .card-img-wrap {
      position: relative;
      width: 100%;
      height: 200px;
      background: #18181b;
      overflow: hidden;
    }

    @media (min-width: 768px) {
      .card-img-wrap { height: 320px; }
    }

    .card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .tag-unique {
      position: absolute;
      top: 8px;
      right: 8px;
      background: rgba(0, 0, 0, 0.85);
      border: 1px solid var(--grunge-gold);
      color: var(--grunge-gold);
      font-size: 0.65rem;
      font-weight: 800;
      padding: 2px 6px;
      border-radius: 4px;
      text-transform: uppercase;
    }

    .sold-badge {
      position: absolute;
      inset: 0;
      background: rgba(9, 9, 11, 0.85);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ef4444;
      font-family: 'Syne', sans-serif;
      font-size: 1.3rem;
      font-weight: 900;
      border: 2px dashed #ef4444;
      margin: 10px;
      border-radius: 6px;
      transform: rotate(-8deg);
      pointer-events: none;
    }

    .card-body {
      padding: 0.9rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      justify-content: space-between;
    }

    .card-title {
      font-size: 0.9rem;
      font-weight: 700;
      margin-bottom: 0.3rem;
      color: #fff;
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .card-meta {
      display: flex;
      flex-direction: column;
      gap: 2px;
      color: var(--text-muted);
      font-size: 0.75rem;
      margin-bottom: 0.6rem;
    }

    .card-price {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 0.6rem;
    }

    .btn-buy {
      background: #27272a;
      color: #fff;
      border: none;
      padding: 0.6rem;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      width: 100%;
      transition: background 0.2s;
    }

    .btn-buy:active:not(:disabled) {
      background: var(--accent);
    }

    .btn-buy:disabled {
      background: #18181b;
      color: #52525b;
      cursor: not-allowed;
      border: 1px solid #27272a;
    }

    /* MODALS */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.88);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 200;
      display: none;
      align-items: flex-end;
      justify-content: center;
      padding: 0;
    }

    @media (min-width: 768px) {
      .modal-backdrop {
        align-items: center;
        padding: 1rem;
      }
    }

    .modal-backdrop.open { display: flex; }

    .modal-box {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 20px 20px 0 0;
      max-width: 600px;
      width: 100%;
      max-height: 88vh;
      overflow-y: auto;
      padding: 1.5rem;
      position: relative;
    }

    @media (min-width: 768px) {
      .modal-box {
        border-radius: 16px;
        padding: 2rem;
      }
    }

    .modal-close {
      position: absolute;
      top: 1rem;
      left: 1rem;
      background: #18181b;
      border: 1px solid var(--border);
      width: 32px;
      height: 32px;
      border-radius: 50%;
      color: #fff;
      font-size: 1.1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .form-group { margin-bottom: 1rem; }
    .form-group label {
      display: block;
      margin-bottom: 0.35rem;
      font-weight: 600;
      font-size: 0.85rem;
      color: #d4d4d8;
    }

    .form-control {
      width: 100%;
      padding: 0.7rem 0.9rem;
      background: #18181b;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: #fff;
      font-family: inherit;
      font-size: 0.9rem;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--accent);
    }

    /* MOCKUP */
    .mockup-container {
      position: relative;
      width: 200px;
      height: 220px;
      background-color: #fff;
      border-radius: 12px;
      margin: 0 auto;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #3f3f46;
    }

    .mockup-print {
      position: absolute;
      top: 30%;
      width: 80px;
      height: 80px;
      object-fit: contain;
      pointer-events: none;
      border: 1px dashed rgba(255, 255, 255, 0.4);
    }

    .btn-admin {
      position: fixed;
      bottom: 15px;
      left: 15px;
      background: #18181b;
      color: #a1a1aa;
      border: 1px solid var(--border);
      padding: 0.45rem 0.9rem;
      border-radius: 999px;
      font-size: 0.75rem;
      cursor: pointer;
      z-index: 90;
    }

    .table-admin {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1rem;
      font-size: 0.8rem;
    }
    .table-admin th, .table-admin td {
      border: 1px solid var(--border);
      padding: 0.45rem;
      text-align: right;
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header>
    <a href="#" class="brand">BACKSTAGE <span>THRIFT</span></a>
    <button class="btn-cart" onclick="toggleCart()">
      <span>🛒 السلة</span>
      <span class="cart-badge" id="cartCount">0</span>
    </button>
  </header>

  <!-- HERO -->
  <section class="hero">
    <h1>Rock & Grunge Archive</h1>
    <p>قطع فريب نادرة 1 of 1 أصلية + استوديو تيشرتات كاستم</p>
    <div class="gender-buttons">
      <button class="btn-gender active" id="btnMen" onclick="setGender('men')">HOMME / رجال</button>
      <button class="btn-gender" id="btnWomen" onclick="setGender('women')">FEMME / نساء</button>
    </div>
  </section>

  <!-- CATEGORIES -->
  <div class="categories-bar" id="categoriesBar"></div>

  <!-- MAIN -->
  <div class="container">
    <!-- CUSTOM BANNER -->
    <div class="custom-tee-banner">
      <div>
        <span style="color: var(--accent); font-weight: 800; font-size: 0.75rem;">⚡ CUSTOM STUDIO</span>
        <h2 style="font-size: 1.4rem; margin: 0.4rem 0 0.8rem;">صمّم التيشيرت الخاص بيك</h2>
        <p style="color: var(--text-muted); margin-bottom: 1.2rem; font-size: 0.85rem; line-height: 1.4;">
          اختار اللون، القياس، وحمل لوغو الفرقة أو الآرت تاعك ونطبعوهولك بجودة عالية.
        </p>
        <button class="btn-buy" style="background: var(--accent); padding: 0.7rem 1.4rem; width: auto;" onclick="openCustomStudio()">
          افتح الستوديو وابدأ ⚡
        </button>
      </div>
    </div>

    <!-- PRODUCTS GRID -->
    <h3 id="currentSectionTitle" style="margin-bottom: 1.2rem; font-size: 1.1rem;">قطع الأرشيف المعروضة</h3>
    <div class="grid" id="productsGrid">
      <div style="grid-column: 1/-1; text-align: center; padding: 2.5rem; color: var(--text-muted);">
        جاري تحميل السلعة من السحابة... ⚡
      </div>
    </div>
  </div>

  <!-- CART MODAL -->
  <div class="modal-backdrop" id="cartModal">
    <div class="modal-box">
      <button class="modal-close" onclick="toggleCart()">✕</button>
      <h2 style="margin-bottom: 1.2rem; font-size: 1.3rem;">سلة المشتريات</h2>

      <div id="cartItemsList" style="margin-bottom: 1.2rem;"></div>

      <hr style="border: 0; border-top: 1px solid var(--border); margin: 1.2rem 0;">

      <h3 style="margin-bottom: 0.8rem; font-size: 1.05rem;">معلومات الشحن (Guepex Skikda)</h3>
      <div class="form-group">
        <label>الاسم واللقب الكامل *</label>
        <input type="text" id="custName" class="form-control" placeholder="مثال: صالح الدين" required>
      </div>

      <div class="form-group">
        <label>رقم الهاتف *</label>
        <input type="tel" id="custPhone" class="form-control" placeholder="06xxxxxxxx" required>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem;">
        <div class="form-group">
          <label>الولاية *</label>
          <select id="custWilaya" class="form-control" onchange="updateDeliveryFees()"></select>
        </div>
        <div class="form-group">
          <label>البلدية *</label>
          <input type="text" id="custCommune" class="form-control" placeholder="البلدية" required>
        </div>
      </div>

      <div class="form-group">
        <label>نوع التوصيل</label>
        <div style="display: flex; gap: 1rem; margin-top: 0.4rem; font-size: 0.85rem;">
          <label style="cursor: pointer;">
            <input type="radio" name="deliveryType" value="home" checked onchange="updateDeliveryFees()"> لباب الدار
          </label>
          <label style="cursor: pointer;">
            <input type="radio" name="deliveryType" value="desk" onchange="updateDeliveryFees()"> استلام من المكتب
          </label>
        </div>
      </div>

      <div style="background: #18181b; padding: 1rem; border-radius: 10px; margin: 1.2rem 0; border: 1px solid var(--border); font-size: 0.9rem;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem;">
          <span>سعر المنتجات:</span>
          <span id="subtotalPrice">0 دج</span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem;">
          <span>مصاريف الشحن:</span>
          <span id="shippingPrice">0 دج</span>
        </div>
        <div style="display: flex; justify-content: space-between; font-weight: 900; font-size: 1.15rem; color: var(--accent); margin-top: 0.6rem; border-top: 1px solid var(--border); padding-top: 0.6rem;">
          <span>المجموع الكلي:</span>
          <span id="totalPrice">0 دج</span>
        </div>
      </div>

      <button class="btn-buy" style="background: #25d366; color: #000; font-weight: 900; padding: 0.9rem;" onclick="submitOrderToWhatsApp()">
        تأكيد الطلب عبر واتساب 🚀
      </button>
    </div>
  </div>

  <!-- CUSTOM STUDIO MODAL -->
  <div class="modal-backdrop" id="studioModal">
    <div class="modal-box">
      <button class="modal-close" onclick="closeCustomStudio()">✕</button>
      <h2 style="font-size: 1.3rem;">استوديو التيشيرت المخصص</h2>
      <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.2rem;">اختر المواصفات وحمل التصميم</p>

      <div class="mockup-container">
        <svg viewBox="0 0 100 100" style="width: 80%; height: 80%; fill: #111;" id="teeSvg">
          <path d="M 30,10 L 40,18 C 45,19 55,19 60,18 L 70,10 L 88,25 L 78,38 L 72,32 L 72,90 L 28,90 L 28,32 L 22,38 L 12,25 Z"/>
        </svg>
        <img id="mockupPrintPreview" class="mockup-print" style="display: none;" src="" alt="print">
      </div>

      <div style="margin-top: 1.2rem;">
        <div class="form-group">
          <label>اختر اللون:</label>
          <div style="display: flex; gap: 0.8rem;">
            <button onclick="setTeeColor('#111111')" style="width: 32px; height: 32px; border-radius: 50%; background: #111; border: 2px solid #fff; cursor: pointer;"></button>
            <button onclick="setTeeColor('#f4f4f5')" style="width: 32px; height: 32px; border-radius: 50%; background: #fff; border: 2px solid #71717a; cursor: pointer;"></button>
            <button onclick="setTeeColor('#3f3f46')" style="width: 32px; height: 32px; border-radius: 50%; background: #3f3f46; border: 1px solid #71717a; cursor: pointer;"></button>
            <button onclick="setTeeColor('#7f1d1d')" style="width: 32px; height: 32px; border-radius: 50%; background: #7f1d1d; border: 1px solid #71717a; cursor: pointer;"></button>
          </div>
        </div>

        <div class="form-group">
          <label>القياس (Taille):</label>
          <select id="customSize" class="form-control">
            <option value="S">S</option>
            <option value="M">M</option>
            <option value="L" selected>L</option>
            <option value="XL">XL</option>
            <option value="XXL">XXL</option>
          </select>
        </div>

        <div class="form-group">
          <label>صورة التصميم:</label>
          <input type="file" id="customFile" accept="image/*" class="form-control" onchange="previewUserPrint(event)">
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin: 1.2rem 0;">
          <div>
            <span style="font-size: 0.8rem; color: var(--text-muted);">السعر:</span>
            <h3 style="color: var(--accent);">2800 دج</h3>
          </div>
          <button class="btn-buy" style="width: auto; padding: 0.7rem 1.5rem; background: var(--accent);" onclick="addCustomTeeToCart()">
            إضافة للسلة 🛒
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ADMIN DASHBOARD -->
  <button class="btn-admin" onclick="triggerAdminAuth()">⚙️ Dashboard</button>

  <div class="modal-backdrop" id="adminModal">
    <div class="modal-box" style="max-width: 750px;">
      <button class="modal-close" onclick="closeAdmin()">✕</button>
      <h2 style="font-size: 1.25rem;">إدارة الأرشيف (Cloud Sync)</h2>

      <form id="addProductForm" onsubmit="saveProductToCloud(event)" style="margin-top: 1rem;">
        <h4 style="margin-bottom: 0.8rem; color: var(--accent); font-size: 0.95rem;">+ إضافة قطعة فريب 1 of 1:</h4>
        <div class="form-group">
          <label>اسم القطعة</label>
          <input type="text" id="pTitle" class="form-control" placeholder="Vintage Jacket..." required>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem;">
          <div class="form-group">
            <label>القسم</label>
            <select id="pGender" class="form-control">
              <option value="men">رجال (Homme)</option>
              <option value="women">نساء (Femme)</option>
              <option value="both">كلاهما (Unisex)</option>
            </select>
          </d
